# Dependencies
node_modules/
.pnpm-store/

# Environment Variables — Never commit secrets!
.env
.env.local
.env.development
.env.development.local
.env.test.local
# .env.production is OK to commit (only public VITE_ URLs, no secrets)

# Build Outputs — client/dist IS committed so Render can serve it
# dist/  <-- intentionally NOT excluded so client/dist is tracked
build/
out/

# Uploads & Temp Files
server/uploads/*
!server/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS / Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
